{
    "autosave": "on_focus_change",
    "edit_predictions": {
        "provider": "open_ai_compatible_api",
        "open_ai_compatible_api": {
            "model": "unsloth/Qwen3.8-27B-GGUF",
            "api_url": "https://unsloth.ofthepines.com/v1/comletions"
        },
        "ollama": {

        }
    },
    "cli_default_open_behavior": "new_window",
    "language_models": {
        "openai_compatible": {
            "Unsloth": {
                "api_url": "https://unsloth.ofthepines.com/v1",
                "available_models": [
                    {
                        "name": "unsloth/Qwen3.8-27B-GGUF",
                        "max_tokens": 200000,
                        "max_output_tokens": 32000,
                        "max_completion_tokens": 200000,
                        "capabilities": {
                            "tools": true,
                            "images": false,
                            "parallel_tool_calls": false,
                            "prompt_cache_key": false,
                            "chat_completions": true,
                            "interleaved_reasoning": false,
                            "max_tokens_parameter": true
                        }
                    }
                ]
            }
        },
        "llama.cpp": {
            "api_url": "http://localhost:8080"
        },
        "ollama": {
            "api_url": "http://localhost:11434"
        }
    },
    "agent": {
        "tool_permissions": {
            "tools": {
                "terminal": {
                    "default": "allow",
                    "always_allow": [
                        {
                            "pattern": "^git\\b"
                        },
                        {
                            "pattern": "^wc\\b"
                        },
                        {
                            "pattern": "^find\\s+/Users/victor\\.depina@gong\\.io/develop/code/gong-web-ui(\\s|$)"
                        },
                        {
                            "pattern": "^echo\\b"
                        },
                        {
                            "pattern": "^find\\s+/Users/victor\\.depina@gong\\.io/develop/code/gong-web-ui/packages/browser-apis(\\s|$)"
                        },
                        {
                            "pattern": "^head\\b"
                        },
                        {
                            "pattern": "^find\\s+/Users/victor\\.depina@gong\\.io/develop/code/gong-web-ui/packages/browser-apis/src(\\s|$)"
                        },
                        {
                            "pattern": "^grep\\b"
                        }
                    ]
                }
            }
        },
        "default_model": {
            "provider": "Unsloth",
            "model": "unsloth/Qwen3.8-27B-GGUF",
            "enable_thinking": false
        },
        "dock": "right",
        "favorite_models": [],
        "model_parameters": []
    },
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always"
                    }
                },
                "javascript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always"
                    }
                }
            },
            "enable_lsp_tasks": true
        }
    },
    "languages": {
        "TypeScript": {
            "inlay_hints": {
                "enabled": true
            }
        }
    },
    "prettier": {
        "allowed": true
    },
    "hard_tabs": false,
    "tab_size": 2,
    "ui_font_weight": 350.0,
    "buffer_font_family": "Anonymous Pro",
    "git_panel": {
        "dock": "right",
    },
    "collaboration_panel": {
        "dock": "right",
    },
    "outline_panel": {
        "dock": "right",
    },
    "project_panel": {
        "dock": "right",
    },
    "vim_mode": true,
    "ui_font_size": 15.0,
    "buffer_font_size": 15.0,
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "Catppuccin Mocha",
    },
    "agent_servers": {
        },
